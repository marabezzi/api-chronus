# Copie este arquivo para .env e preencha com os valores reais do seu relógio.
# NUNCA suba o arquivo .env para o GitHub!
# IP ou hostname do relógio iDClass na rede
IDCLASS_HOST=192.168.0.1
# Usuário padrão do relógio (padrão de fábrica: admin)
IDCLASS_USER=admin
# Senha do relógio (padrão de fábrica: admin — TROQUE em produção!)
IDCLASS_PASSWORD=admin
# Porta de comunicação (padrão iDClass: 443)
IDCLASS_PORT=443
# Perfil ativo: "dev" para local, "prod" para produção
SPRING_PROFILES_ACTIVE=dev


# Dados da empresa para o cabeçalho do AFDT
EMPRESA_CNPJ=00000000000000
EMPRESA_RAZAO_SOCIAL=NOME DA EMPRESA LTDA
EMPRESA_CEI=000000000000
EMPRESA_LOCAL=RUA EXEMPLO, 100, CENTRO, CIDADE-SP
EMPRESA_NUM_FABRICACAO=00000000000000000


# PostgreSQL
POSTGRES_DB=chronus
POSTGRES_USER=chronus
POSTGRES_PASSWORD=chronus_senha_segura

# Logos para o PDF do Espelho de Ponto
LOGO_EMPRESA_PATH=/app/logos/empresa.png
LOGO_CHRONUS_PATH=/app/logos/chronus.png

# Timezone da empresa
APP_TIMEZONE=America/Sao_Paulo